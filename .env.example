# ── Runtime ───────────────────────────────────────────────────────────────────
NODE_ENV=development
# lista separada por vírgula: api,sqs-consumer,outbox-publisher,pending-reference-worker,
# reconciliation-job,outbox-retention-job
ROLE=api,sqs-consumer,outbox-publisher,pending-reference-worker,reconciliation-job,outbox-retention-job
PORT=3001
INSTANCE_ID=api-1
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://wagering_app:wagering_app@localhost:5432/wagering
DATABASE_URL_MIGRATOR=postgres://wagering_migrator:wagering_migrator@localhost:5432/wagering
PG_POOL_MAX=48

# ── SQS (LocalStack) ──────────────────────────────────────────────────────────
SQS_ENDPOINT=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_TRANSACTIONS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/wager-events.fifo
SQS_CONSUMER_CONCURRENCY=8
# Assinatura HMAC-SHA256 do envelope (obrigatória em produção)
SQS_REQUIRE_SIGNATURE=false
SQS_SIGNING_SECRET=

# ── Auth (Keycloak) ───────────────────────────────────────────────────────────
AUTH_ENABLED=true
KEYCLOAK_ISSUER=http://localhost:8080/realms/jungle
KEYCLOAK_JWKS_URL=http://localhost:8080/realms/jungle/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=wagering-api
# Algoritmos aceitos (nunca derive do header alg do token)
JWT_ALGORITHMS=RS256
JWT_CLOCK_TOLERANCE_SECONDS=5

# ── Domain allow-lists ────────────────────────────────────────────────────────
SUPPORTED_CURRENCIES=BRL,USD
PROVIDERS=provider-a,provider-b

# ── Observability ─────────────────────────────────────────────────────────────
METRICS_ENABLED=true
# Token exigido no scrape de /metrics (obrigatório em produção, mín. 16 chars)
METRICS_AUTH_TOKEN=
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=wagering-api

# ── Tunables (defaults conservadores) ─────────────────────────────────────────
LOCK_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=10000
IDLE_TX_TIMEOUT_MS=15000
TX_MAX_RETRIES=3
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_MS=30000
PENDING_WORKER_POLL_MS=2000
RECONCILE_SWEEP_MS=300000
SHUTDOWN_GRACE_MS=25000

# ── Fault injection (NUNCA em produção) ───────────────────────────────────────
# Em produção o boot FALHA se FAULT_INJECTION_ENABLED=true.
FAULT_INJECTION_ENABLED=false
FAULT_CRASH_AFTER_COMMIT_BEFORE_ACK=0
FAULT_CRASH_AFTER_PUBLISH_BEFORE_MARK=0
FAULT_CRASH_AFTER_CLAIM_OUTBOX=0
FAULT_DELAY_LOCK_MS=0

# ── Hardening de produção (validação fail-fast no boot) ───────────────────────
# Com NODE_ENV=production o processo NÃO sobe se:
#   - AUTH_ENABLED=false
#   - FAULT_INJECTION_ENABLED=true
#   - SQS_REQUIRE_SIGNATURE=false / SQS_SIGNING_SECRET vazio
#   - METRICS_AUTH_TOKEN vazio
#   - DATABASE_URL com credenciais padrão (wagering_app/wagering_app, postgres/postgres)
#   - AWS_ACCESS_KEY_ID/SECRET com valor "test"
#   - KEYCLOAK_ISSUER / KEYCLOAK_JWKS_URL sem HTTPS
