{
  "name": "distributed-wagering-processor",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "bun run --watch src/main.ts",
    "start": "bun run src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "test": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:system": "bun test test/system",
    "test:security": "bun test test/security",
    "test:observability": "bun test test/observability",
    "test:postman": "bunx newman@6 run postman/wagering.postman_collection.json -e postman/wagering.local.postman_environment.json --delay-request 500",
    "test:all": "bun test",
    "test:load": "k6 run test/load/wager-load.js",
    "migrate:up": "bun run src/contexts/wagering/infrastructure/persistence/cli/migrate.ts up",
    "migrate:down": "bun run src/contexts/wagering/infrastructure/persistence/cli/migrate.ts down",
    "migrate:fresh": "bun run src/contexts/wagering/infrastructure/persistence/cli/migrate.ts fresh",
    "seed:dev": "bun run src/contexts/wagering/infrastructure/persistence/cli/seed.ts",
    "seed:load": "bun run src/contexts/wagering/infrastructure/persistence/cli/seed.ts --wallets=10000"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.700.0",
    "@fastify/helmet": "11",
    "@fastify/rate-limit": "9",
    "@mikro-orm/core": "^6.4.0",
    "@mikro-orm/migrations": "^6.4.0",
    "@mikro-orm/postgresql": "^6.4.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-fastify": "^10.4.15",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-node": "^1.30.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "decimal.js": "^10.4.3",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/node": "^22.10.2",
    "dependency-cruiser": "^16.9.0",
    "eslint": "^9.17.0",
    "testcontainers": "^10.16.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0"
  }
}
