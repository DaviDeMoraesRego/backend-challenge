{
  "uid": "wagering-overview",
  "title": "Wagering — Overview",
  "tags": ["wagering", "jungle"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-15m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Throughput de transações (por kind/status)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (kind, status) (rate(wager_transactions_total[1m]))",
          "legendFormat": "{{kind}} / {{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Latência HTTP p50/p95/p99",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latência de processamento SQS p95/p99",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, queue) (rate(sqs_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p95 {{queue}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le, queue) (rate(sqs_processing_duration_seconds_bucket[5m])))",
          "legendFormat": "p99 {{queue}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Duplicatas detectadas (replay × conflito)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type, channel) (rate(wager_duplicates_total[5m]))",
          "legendFormat": "{{type}} / {{channel}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Retries (tx, outbox, pending)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (sqlstate) (rate(db_transaction_retries_total[5m]))",
          "legendFormat": "tx {{sqlstate}}"
        },
        {
          "refId": "B",
          "expr": "sum(rate(outbox_publish_attempts_total{result=\"retry\"}[5m]))",
          "legendFormat": "outbox retry"
        },
        {
          "refId": "C",
          "expr": "sum(rate(pending_reference_retries_total[5m]))",
          "legendFormat": "pending retry"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Mensagens enviadas à DLQ",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (queue) (increase(dlq_messages_total[15m]))", "legendFormat": "{{queue}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Conflitos de lock por SQLSTATE",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (sqlstate) (rate(db_lock_conflicts_total[5m]))", "legendFormat": "{{sqlstate}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox lag (s) e backlog",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max(outbox_lag_seconds)", "legendFormat": "lag (s)" },
        { "refId": "B", "expr": "max(outbox_backlog)", "legendFormat": "backlog" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Reconciliação (divergências e cobertura)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (source) (increase(reconciliation_divergences_total[15m]))", "legendFormat": "divergências {{source}}" },
        { "refId": "B", "expr": "sum by (source) (rate(reconciliation_checked_entries_total[5m]))", "legendFormat": "checados/s {{source}}" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Saturação: inflight SQS e pool PG",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "max by (queue) (sqs_inflight)", "legendFormat": "inflight {{queue}}" },
        { "refId": "B", "expr": "max(pg_pool_total)", "legendFormat": "pool total" },
        { "refId": "C", "expr": "max(pg_pool_waiting)", "legendFormat": "pool waiting" }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Instâncias/roles ativas (up)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "refId": "A", "expr": "sum by (instance, role) (up{job=\"wagering-api\"})", "legendFormat": "{{instance}} ({{role}})" }
      ]
    }
  ]
}
