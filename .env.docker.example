# Copie para `.env` (mesmo diretório do docker-compose.yml) e preencha.
# Os valores abaixo são EXEMPLOS DE DESENVOLVIMENTO. Em produção use segredos
# gerados aleatoriamente e um secret manager.

# ── Modo ──────────────────────────────────────────────────────────────────────
# `production` ativa as validações de hardening do boot (fail-fast).
NODE_ENV=development
AUTH_ENABLED=true

# ── Banco ─────────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
APP_DB_PASSWORD=wagering_app
MIGRATOR_DB_PASSWORD=wagering_migrator

# ── SQS (LocalStack em dev) ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
# Em produção: true + segredo de 32+ chars
SQS_REQUIRE_SIGNATURE=false
SQS_SIGNING_SECRET=

# ── Métricas ──────────────────────────────────────────────────────────────────
# Obrigatório em produção (mín. 16 chars). Prometheus deve enviar
# `Authorization: Bearer <token>`.
METRICS_AUTH_TOKEN=

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ALGORITHMS=RS256

# ── Serviços auxiliares ───────────────────────────────────────────────────────
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
